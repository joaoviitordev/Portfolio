---
// Header — nav + botões de tema/idioma/menu + painel mobile.
// Renderiza em PT; o toggle de idioma troca os textos via data-i18n (src/scripts/ui.ts).
const navLinks = [
  { key: 'nav0', href: '#sobre', label: 'SOBRE MIM' },
  { key: 'nav1', href: '#projetos', label: 'PROJETOS' },
  { key: 'nav2', href: '#tecnologias', label: 'TECNOLOGIAS' },
  { key: 'nav3', href: '#educacao', label: 'EDUCAÇÃO' },
  { key: 'nav4', href: '#contato', label: 'CONTATO' },
];
---

{/* Sem border-bottom: a separação vem do degradê em `header::after` (global.css),
    que só aparece quando há conteúdo passando por baixo. */}
<header style="position:sticky;top:0;z-index:50;background:var(--chrome-bg);backdrop-filter:blur(10px);">
  <div data-m="bar" style="max-width:1200px;margin:0 auto;padding:14px clamp(20px,4vw,40px);display:flex;align-items:center;justify-content:space-between;gap:24px;">
    <div data-m="brand" data-i18n="brand" style="font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(13px,1.6vw,16px);line-height:1.35;white-space:pre-line;">/* Desenvolvedor
Full-Stack */</div>
    <nav data-m="nav" style="display:flex;align-items:center;gap:clamp(14px,2.4vw,32px);">
      <div data-m="nav-links" style="display:flex;align-items:center;gap:clamp(16px,3vw,40px);">
        {navLinks.map((link) => (
          <a href={link.href} data-i18n={link.key} data-nav-link={link.href} class="nav-link" style="font-size:14px;font-weight:600;letter-spacing:0.04em;">{link.label}</a>
        ))}
      </div>
      <button type="button" id="menu-btn" data-s="pill" data-m="menu-btn" data-mm="tap" data-i18n-aria="menuAria" aria-label="Abrir menu" title="Abrir menu" aria-expanded="false" aria-controls="menu-panel" style="display:none;width:34px;height:34px;flex:none;align-items:center;justify-content:center;padding:0;border-radius:10px;cursor:pointer;" class="pill">
        <span id="menu-icon" style="display:flex;"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></span>
      </button>
      <button type="button" id="lang-btn" data-s="pill" data-mm="tap" data-i18n-aria="langAria" aria-label="Mudar idioma para inglês" title="Mudar idioma para inglês" style="width:34px;height:34px;flex:none;display:flex;align-items:center;justify-content:center;padding:0;border-radius:10px;cursor:pointer;font-family:JetBrains Mono,monospace;font-size:11px;font-weight:700;letter-spacing:0.02em;" class="pill">
        <span id="lang-label">EN</span>
      </button>
      <button type="button" id="theme-btn" data-s="pill" data-mm="tap" data-i18n-aria="themeAria" aria-label="Alternar tema" title="Alternar tema" style="width:34px;height:34px;flex:none;display:flex;align-items:center;justify-content:center;padding:0;border-radius:10px;cursor:pointer;" class="pill">
        <span id="theme-icon" style="display:flex;"><svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M20 14.5A8.5 8.5 0 019.5 4a8.5 8.5 0 1010.5 10.5z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
      </button>
    </nav>
  </div>

  {/* Sem `hidden`: quem recolhe o painel é o CSS, e só quando html[data-js] existe.
      Assim, sem JS ele nasce aberto — é a única navegação que sobra no mobile,
      onde os links do header estão escondidos pela media query. */}
  {/* Três níveis de propósito: o item de grid (menu-panel-row) não pode ter
      padding nem borda, senão eles continuam ocupando altura mesmo com a linha
      colapsada em 0fr. Tudo o que tem espessura mora no nível de dentro, que é
      recortado junto. */}
  <div id="menu-panel" data-m="panel">
    <div class="menu-panel-row">
      <div class="menu-panel-inner">
        {navLinks.map((link) => (
          <a href={link.href} data-i18n={link.key} data-nav-link={link.href} data-m="menu-link" class="nav-link menu-close" style="font-size:15px;font-weight:600;letter-spacing:0.04em;padding:13px 0;border-bottom:1px solid var(--line-soft);">{link.label}</a>
        ))}
      </div>
    </div>
  </div>

  {/* Barra de progresso na base do header: cresce da esquerda para a direita
      conforme a página rola (escala aplicada em src/scripts/ui.ts).
      z-index a mais para ficar acima do degradê do ::after. */}
  <div id="scroll-progress" aria-hidden="true" style="position:absolute;left:0;right:0;bottom:0;height:2px;z-index:1;background:var(--ink);transform:scaleX(0);transform-origin:left center;will-change:transform;pointer-events:none;"></div>
</header>
