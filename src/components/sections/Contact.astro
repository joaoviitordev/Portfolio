---
// Contato + rodapé. O ano é preenchido por src/scripts/ui.ts.
// A data é a do build (= último deploy), gerada aqui e não no cliente: no cliente
// ela seria sempre "hoje" e o rótulo "última atualização" viraria mentira.
const pad = (n: number) => String(n).padStart(2, '0');
const built = new Date();
const lastUpdate = `${pad(built.getDate())}/${pad(built.getMonth() + 1)}/${built.getFullYear()}`;

// Texto em PT do markup; o inglês vem do DICT em ui.ts pela chave jobsChips<i>.
const jobsChips = ['Júnior / Estágio', 'Remoto, híbrido ou presencial', 'CLT ou PJ'];

const email = 'joaovitorgomesdefaria@gmail.com';
const github = 'https://github.com/joaoviitordev';
const linkedin = 'https://www.linkedin.com/in/joaovitor-faria/';
---

<section data-screen-label="Contato" id="contato" data-s="page" style="background:linear-gradient(180deg,#ffffff,#fafafa);border-top:1px solid rgba(23,23,23,0.08);">
  <div style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px) clamp(30px,4vw,50px);">
    <div data-i18n="contactTitle" data-anim style="--i:0;font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(18px,2.4vw,24px);margin-bottom:8px;">/* CONTATO */</div>

    <div data-i18n="contactSub" data-s="muted" data-anim style="--i:1;font-family:JetBrains Mono,monospace;font-size:13px;color:#8b8b92;margin-bottom:36px;">// aberto a freelas, vagas full-stack e projetos colaborativos</div>

    <div data-anim-group style="display:flex;flex-direction:column;gap:18px;">
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(340px,1fr));gap:18px;align-items:stretch;">
        <!-- Vagas primeiro: é a chamada principal da seção. -->
        <div data-s="card" data-anim style="--i:0;border:1px solid rgba(23,23,23,0.1);background:#fff;border-radius:20px;padding:clamp(24px,3vw,32px);display:flex;flex-direction:column;gap:12px;">
          <div style="display:flex;align-items:center;gap:12px;">
            <div data-s="solid" style="width:38px;height:38px;flex:none;border-radius:10px;background:#171717;display:flex;align-items:center;justify-content:center;">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 8.5h18V19a1 1 0 01-1 1H4a1 1 0 01-1-1V8.5z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 8.5V6a1 1 0 011-1h4a1 1 0 011 1v2.5" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M3 13h18" stroke="#fff" stroke-width="1.8"/></svg>
            </div>
            <div data-i18n="jobsLabel" data-s="muted" style="font-family:JetBrains Mono,monospace;font-size:13px;color:#8b8b92;">// vagas e oportunidades</div>
          </div>
          <div data-i18n="jobsTitle" style="font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(18px,2.2vw,24px);line-height:1.25;">Aberto a oportunidades full-stack</div>
          <div data-i18n="jobsBody" data-s="muted" style="font-size:15px;line-height:1.6;color:#4b4b52;max-width:54ch;text-wrap:pretty;">Procuro posições júnior ou de estágio em desenvolvimento web e full-stack, no Rio de Janeiro ou remoto. Se o perfil fizer sentido para o time, meu currículo está a um clique.</div>
          <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:2px;">
            {jobsChips.map((chip, i) => (
              <div data-i18n={`jobsChips${i}`} data-s="pill" style="font-family:JetBrains Mono,monospace;font-size:12px;padding:6px 12px;border:1px solid rgba(23,23,23,0.14);border-radius:999px;background:linear-gradient(180deg,#ffffff,#f4f4f5);white-space:nowrap;">{chip}</div>
            ))}
          </div>
          <!-- margin-top:auto cola os botões na base, alinhando com a CTA do painel ao lado -->
          <div style="margin-top:auto;padding-top:8px;display:flex;flex-wrap:wrap;gap:10px;">
            <a href="/doc/joaovitor_curriculo_BR.pdf" target="_blank" rel="noopener" data-s="solid" class="solid hv-lift" style="flex:1 1 auto;display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:999px;padding:15px 26px;font-size:15px;font-weight:600;text-decoration:none;transition:transform .2s,background .2s;">
              <svg width="16" height="16" viewBox="0 0 22 22" fill="none"><path d="M12.8332 1.83332H5.49984C5.01361 1.83332 4.54729 2.02647 4.20347 2.37029C3.85966 2.7141 3.6665 3.18042 3.6665 3.66665V18.3333C3.6665 18.8195 3.85966 19.2859 4.20347 19.6297C4.54729 19.9735 5.01361 20.1666 5.49984 20.1666H16.4998C16.9861 20.1666 17.4524 19.9735 17.7962 19.6297C18.14 19.2859 18.3332 18.8195 18.3332 18.3333V7.33332M12.8332 1.83332C13.1233 1.83285 13.4107 1.88978 13.6788 2.00085C13.9469 2.11192 14.1904 2.27493 14.3952 2.48048L17.6842 5.76948C17.8903 5.97436 18.0537 6.21805 18.1651 6.48646C18.2765 6.75488 18.3336 7.0427 18.3332 7.33332M12.8332 1.83332V6.41665C12.8332 6.65976 12.9297 6.89292 13.1017 7.06483C13.2736 7.23674 13.5067 7.33332 13.7498 7.33332L18.3332 7.33332M9.1665 8.24998H7.33317M14.6665 11.9166H7.33317M14.6665 15.5833H7.33317" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span data-i18n="cv">Visualizar CV</span>
            </a>
            <a href={linkedin} target="_blank" rel="noopener" data-i18n="jobsCta" data-s="pill" class="pill hv-lift" style="flex:1 1 auto;display:inline-flex;align-items:center;justify-content:center;gap:9px;border-radius:999px;padding:14px 26px;font-size:15px;font-weight:600;text-decoration:none;transition:transform .2s,background .2s;">Ver LinkedIn</a>
          </div>
        </div>

        <!-- Painel escuro: convite principal. Não usa data-s porque já é escuro no tema claro. -->
        <div data-m="cta-panel" data-anim style="--i:1;background:#171717;border:1px solid rgba(23,23,23,0.1);border-radius:20px;padding:clamp(26px,3.4vw,36px);display:flex;flex-direction:column;gap:18px;color:#f4f4f5;">
          <div data-i18n="contactAvail" style="align-self:flex-start;font-family:JetBrains Mono,monospace;font-size:12px;color:#c9c9d1;border:1px solid rgba(255,255,255,0.18);border-radius:999px;padding:6px 12px;">Disponível para novos projetos</div>
          <div data-i18n="contactLead" style="font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(22px,2.8vw,32px);line-height:1.2;">Do protótipo ao deploy em produção.</div>
          <div data-i18n="contactBody" style="font-size:15px;line-height:1.65;color:#b8b8c0;max-width:44ch;text-wrap:pretty;">Conte sobre a ideia, o prazo e o que já existe. Respondo com um plano inicial e os próximos passos.</div>
          <a href={`mailto:${email}`} class="cta-light" style="margin-top:auto;display:inline-flex;align-items:center;justify-content:center;gap:10px;border-radius:999px;padding:15px 24px;font-size:15px;font-weight:600;text-decoration:none;transition:transform .2s,background .2s;">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none"><path d="M3 6h18v12H3V6z" stroke="#171717" stroke-width="1.8"/><path d="M3 7l9 6 9-6" stroke="#171717" stroke-width="1.8"/></svg>
            <span data-i18n="contactCta">Enviar email</span>
          </a>
          <div data-i18n="contactReply" style="font-family:JetBrains Mono,monospace;font-size:12px;color:#8b8b92;">// costumo responder em até 24h</div>
        </div>
      </div>

      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:14px;">
        <a href={`mailto:${email}`} data-s="card" class="hv-card" data-anim style="--i:2;display:flex;align-items:center;gap:16px;border:1px solid rgba(23,23,23,0.1);background:#fff;border-radius:16px;padding:20px 22px;text-decoration:none;color:#171717;transition:transform .2s,box-shadow .2s;">
          <div data-s="solid" style="width:40px;height:40px;flex:none;border-radius:11px;background:#171717;display:flex;align-items:center;justify-content:center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><path d="M3 6h18v12H3V6z" stroke="#fff" stroke-width="1.8"/><path d="M3 7l9 6 9-6" stroke="#fff" stroke-width="1.8"/></svg>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px;min-width:0;flex:1;">
            <div data-s="muted" style="font-size:12px;font-family:JetBrains Mono,monospace;color:#8b8b92;">Email</div>
            <div style="font-size:14px;font-weight:600;word-break:break-all;">{email}</div>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="flex:none;"><path d="M7 17L17 7M9 7h8v8" stroke="#8b8b92" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <a href={github} target="_blank" rel="noopener" data-s="card" class="hv-card" data-anim style="--i:3;display:flex;align-items:center;gap:16px;border:1px solid rgba(23,23,23,0.1);background:#fff;border-radius:16px;padding:20px 22px;text-decoration:none;color:#171717;transition:transform .2s,box-shadow .2s;">
          <div data-s="solid" style="width:40px;height:40px;flex:none;border-radius:11px;background:#171717;display:flex;align-items:center;justify-content:center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.46-1.2-1.11-1.52-1.11-1.52-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05a9.3 9.3 0 015 0c1.9-1.32 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0022 12.2C22 6.58 17.52 2 12 2z"/></svg>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px;min-width:0;flex:1;">
            <div data-s="muted" style="font-size:12px;font-family:JetBrains Mono,monospace;color:#8b8b92;">GitHub</div>
            <div style="font-size:14px;font-weight:600;">github.com/joaoviitordev</div>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="flex:none;"><path d="M7 17L17 7M9 7h8v8" stroke="#8b8b92" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        <a href={linkedin} target="_blank" rel="noopener" data-s="card" class="hv-card" data-anim style="--i:4;display:flex;align-items:center;gap:16px;border:1px solid rgba(23,23,23,0.1);background:#fff;border-radius:16px;padding:20px 22px;text-decoration:none;color:#171717;transition:transform .2s,box-shadow .2s;">
          <div data-s="solid" style="width:40px;height:40px;flex:none;border-radius:11px;background:#171717;display:flex;align-items:center;justify-content:center;">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="#fff"><path d="M6.94 5a2 2 0 11-4-.02 2 2 0 014 .02zM3.28 8.98h3.6V21h-3.6V8.98zM9.4 8.98h3.46v1.64h.05c.48-.9 1.65-1.85 3.4-1.85 3.64 0 4.3 2.4 4.3 5.5V21h-3.6v-5.9c0-1.4-.03-3.2-1.96-3.2-1.96 0-2.26 1.53-2.26 3.1V21H9.4V8.98z"/></svg>
          </div>
          <div style="display:flex;flex-direction:column;gap:4px;min-width:0;flex:1;">
            <div data-s="muted" style="font-size:12px;font-family:JetBrains Mono,monospace;color:#8b8b92;">LinkedIn</div>
            <div style="font-size:14px;font-weight:600;">linkedin.com/in/joaovitor-faria</div>
          </div>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" style="flex:none;"><path d="M7 17L17 7M9 7h8v8" stroke="#8b8b92" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </div>

  <div data-s="page" style="border-top:1px solid rgba(23,23,23,0.08);background:linear-gradient(90deg,#f4f4f5,#ffffff);">
    <div style="max-width:1200px;margin:0 auto;padding:18px clamp(20px,4vw,40px);display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap;">
      <span style="font-size:13px;color:#8b8b92;">© <span id="year">2026</span> joaoviitordev · <span data-i18n="lastUpdate">Última atualização:</span> <span id="date-str">{lastUpdate}</span></span>
      <div style="display:flex;align-items:center;gap:12px;">
        <a href="https://www.linkedin.com/in/joaovitor-faria/" target="_blank" rel="noopener" data-s="solid" class="solid" style="width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#fff"><path d="M6.94 5a2 2 0 11-4-.02 2 2 0 014 .02zM3.28 8.98h3.6V21h-3.6V8.98zM9.4 8.98h3.46v1.64h.05c.48-.9 1.65-1.85 3.4-1.85 3.64 0 4.3 2.4 4.3 5.5V21h-3.6v-5.9c0-1.4-.03-3.2-1.96-3.2-1.96 0-2.26 1.53-2.26 3.1V21H9.4V8.98z"/></svg>
        </a>
        <a href="https://github.com/joaoviitordev" target="_blank" rel="noopener" data-s="solid" class="solid" style="width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="#fff"><path d="M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.46-1.2-1.11-1.52-1.11-1.52-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05a9.3 9.3 0 015 0c1.9-1.32 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0022 12.2C22 6.58 17.52 2 12 2z"/></svg>
        </a>
        <a href="mailto:joaovitorgomesdefaria@gmail.com" data-s="solid" class="solid" style="width:32px;height:32px;border-radius:50%;display:flex;align-items:center;justify-content:center;">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M3 6h18v12H3V6z" stroke="#fff" stroke-width="1.8"/><path d="M3 7l9 6 9-6" stroke="#fff" stroke-width="1.8"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
