---
// Educação — linha do tempo com badge de ícone no trilho + card. Dados em src/data/education.ts.
import { academic, courses, type EduItem } from '../../data/education';

// Ícones traçados (stroke branco): dentro do badge data-s="solid" o CSS do dark
// inverte o traço junto com o fundo, como no resto do site.
const ICONS: Record<EduItem['icon'], string> = {
  cap: '<path d="M12 4L2 9l10 5 10-5-10-5z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 11.5V17c0 1.1 2.7 2.5 6 2.5s6-1.4 6-2.5v-5.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  terminal:
    '<rect x="3" y="4.5" width="18" height="15" rx="2.5" stroke="#fff" stroke-width="1.8"/><path d="M7.5 10l2.5 2.5-2.5 2.5M13 15h3.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
  rocket:
    '<path d="M12 2.5c3 2 4.5 5 4.5 8.5L14 14h-4l-2.5-3c0-3.5 1.5-6.5 4.5-8.5z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 14l-2.5 1 .5 4 2.5-2.5M14 14l2.5 1-.5 4-2.5-2.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><circle cx="12" cy="9.5" r="1.6" stroke="#fff" stroke-width="1.8"/>',
  spark:
    '<path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9L12 3z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M17.5 15.5l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/>',
  code: '<path d="M8 8l-4 4 4 4M16 8l4 4-4 4M13.5 5l-3 14" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
};

// A cascata de entrada segue a lista inteira, sem reiniciar no segundo grupo.
const groups = [
  { label: '// formação acadêmica', i18n: 'eduGroupAcademic', items: academic },
  { label: '// cursos complementares', i18n: 'eduGroupCourses', items: courses },
];
let step = 2;
---

<section data-screen-label="Educação" id="educacao" style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);">
  <h2 data-i18n="eduTitle" data-anim style="--i:0;font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(18px,2.4vw,24px);margin:0 0 8px;">/* EDUCAÇÃO */</h2>
  <div data-i18n="eduSub" data-s="muted" data-anim style="--i:1;font-family:JetBrains Mono,monospace;font-size:13px;color:#8b8b92;margin-bottom:clamp(30px,5vw,50px);">// formação acadêmica e cursos</div>

  {groups.map((group) => (
    <div class="edu-group" data-anim-group>
      <h3 class="edu-group-label" data-i18n={group.i18n} data-s="muted" data-anim style={`--i:${step++};`}>{group.label}</h3>

      <ol class="edu-list">
        {group.items.map((item) => (
          <li class="edu-item" data-anim style={`--i:${step++};`}>
            <span class="edu-badge" data-s="solid" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" set:html={ICONS[item.icon]} />
            </span>

            <div class="edu-card hv-card" data-s="card">
              <div class="edu-head">
                <h4 class="edu-course" data-i18n={`${item.key}Title`}>{item.course}</h4>
                <span class="edu-year" data-s="pill">{item.year}</span>
              </div>

              <div class="edu-inst">
                <span>{item.institution}</span>
                {item.current && <span class="edu-status" data-i18n="eduCurrent">Cursando</span>}
              </div>

              {item.detail && (
                <p class="edu-detail" data-s="muted" data-i18n={`${item.key}Body`}>{item.detail}</p>
              )}
            </div>
          </li>
        ))}
      </ol>
    </div>
  ))}

  <div data-i18n="eduFooter" data-s="muted" data-anim style={`--i:${step};margin-top:clamp(18px,2.5vw,26px);text-align:right;font-family:JetBrains Mono,monospace;font-size:13px;color:#8b8b92;`}>// Em constante evolução</div>
</section>
