// Educação — placeholder enquanto o conteúdo não é definido.
---

<section data-screen-label="Educação" id="educacao" style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);">
  <div data-i18n="eduTitle" data-anim style="--i:0;font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(18px,2.4vw,24px);margin-bottom:8px;">/* EDUCAÇÃO */</div>
  <div data-i18n="eduSub" data-s="muted" data-anim style="--i:1;font-family:JetBrains Mono,monospace;font-size:13px;color:#8b8b92;margin-bottom:clamp(30px,5vw,50px);">// formação acadêmica e cursos</div>

  <div data-s="card" data-anim style="--i:2;display:flex;flex-direction:column;align-items:center;gap:14px;text-align:center;border:1px dashed rgba(23,23,23,0.2);background:#fff;border-radius:16px;padding:clamp(36px,6vw,60px) clamp(20px,4vw,32px);">
    <div data-s="solid" style="width:44px;height:44px;border-radius:12px;background:#171717;display:flex;align-items:center;justify-content:center;">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none"><path d="M12 4L2 9l10 5 10-5-10-5z" stroke="#fff" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 11.5V17c0 1.1 2.7 2.5 6 2.5s6-1.4 6-2.5v-5.5" stroke="#fff" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </div>
    <div data-i18n="eduSoon" style="font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(16px,2vw,20px);">Em construção</div>
    <div data-i18n="eduSoonBody" data-s="muted" style="font-size:clamp(14px,1.5vw,16px);color:#4b4b52;line-height:1.6;max-width:520px;">Esta seção está sendo preparada e em breve trará minha formação acadêmica e certificações.</div>
  </div>

  <div data-i18n="eduFooter" data-s="muted" data-anim style="--i:3;margin-top:clamp(18px,2.5vw,26px);text-align:right;font-family:JetBrains Mono,monospace;font-size:13px;color:#8b8b92;">// Em constante evolução</div>
</section>
