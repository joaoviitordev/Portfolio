---
// Hero — pill de localização, título, CTAs e card com carrossel dos projetos.
import { Image } from 'astro:assets';
import { projects } from '../../data/projects';
---

<section id="hero" data-screen-label="Hero" data-m="hero" style="max-width:1200px;margin:0 auto;padding:clamp(48px,8vw,110px) clamp(20px,4vw,40px) clamp(72px,9vw,120px);display:grid;grid-template-columns:minmax(280px,1fr) minmax(300px,1fr);gap:clamp(32px,5vw,60px);align-items:center;">
  <div>
    <div data-s="pill" data-anim style="--i:0;display:inline-flex;align-items:center;gap:8px;border:1px solid rgba(23,23,23,0.15);background:linear-gradient(180deg,#ffffff,#f1f1f3);border-radius:999px;padding:7px 16px;font-size:13px;color:#4b4b52;margin-bottom:22px;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8z" stroke="#4b4b52" stroke-width="2"/><circle cx="12" cy="10" r="2.6" fill="#4b4b52"/></svg>
      <span data-i18n="location">Rio de Janeiro, Brasil</span>
    </div>
    <h1 data-anim style="--i:1;font-size:clamp(40px,6vw,64px);font-weight:700;line-height:1.02;letter-spacing:-0.02em;margin:0 0 18px;">João Vitor</h1>
    <div data-s="muted" data-anim style="--i:2;font-size:clamp(14px,1.6vw,17px);color:#5b5b62;margin-bottom:14px;">React&nbsp; · &nbsp;Next.js&nbsp; · &nbsp;TypeScript&nbsp; · &nbsp;IA&nbsp; · &nbsp;Git/GitHub&nbsp; · &nbsp;Node.js</div>
    <p data-s="muted" data-i18n="heroTagline" data-anim style="--i:3;max-width:44ch;font-size:clamp(15px,1.7vw,18px);line-height:1.5;color:#4b4b52;margin:0 0 30px;">Desenvolvedor full-stack focado em criar interfaces modernas e funcionais.</p>
    <div data-anim style="--i:4;display:flex;gap:14px;flex-wrap:wrap;">
      <a href="/doc/joaovitor_curriculo_BR.pdf" target="_blank" rel="noopener" data-s="solid" data-m="cta" class="hv-solid-cta" style="display:inline-flex;align-items:center;gap:8px;background:#171717;color:#fff;border-radius:999px;padding:14px 24px;font-size:14px;font-weight:600;text-decoration:none;box-shadow:0 1px 2px rgba(0,0,0,0.15);">
        <svg width="16" height="16" viewBox="0 0 22 22" fill="none"><path d="M12.8332 1.83332H5.49984C5.01361 1.83332 4.54729 2.02647 4.20347 2.37029C3.85966 2.7141 3.6665 3.18042 3.6665 3.66665V18.3333C3.6665 18.8195 3.85966 19.2859 4.20347 19.6297C4.54729 19.9735 5.01361 20.1666 5.49984 20.1666H16.4998C16.9861 20.1666 17.4524 19.9735 17.7962 19.6297C18.14 19.2859 18.3332 18.8195 18.3332 18.3333V7.33332M12.8332 1.83332C13.1233 1.83285 13.4107 1.88978 13.6788 2.00085C13.9469 2.11192 14.1904 2.27493 14.3952 2.48048L17.6842 5.76948C17.8903 5.97436 18.0537 6.21805 18.1651 6.48646C18.2765 6.75488 18.3336 7.0427 18.3332 7.33332M12.8332 1.83332V6.41665C12.8332 6.65976 12.9297 6.89292 13.1017 7.06483C13.2736 7.23674 13.5067 7.33332 13.7498 7.33332L18.3332 7.33332M9.1665 8.24998H7.33317M14.6665 11.9166H7.33317M14.6665 15.5833H7.33317" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        <span data-i18n="cv">Visualizar CV</span>
      </a>
      <a href="#contato" data-s="pill" data-m="cta" data-i18n="getInTouch" class="hv-pill" style="display:inline-flex;align-items:center;gap:8px;background:linear-gradient(180deg,#ffffff,#eeeef0);border:1px solid rgba(23,23,23,0.15);color:#171717;border-radius:999px;padding:14px 24px;font-size:14px;font-weight:600;text-decoration:none;">Entrar em contato</a>
      <a href="https://github.com/joaoviitordev" target="_blank" rel="noopener" aria-label="GitHub" data-s="pill" data-m="cta" class="hv-pill" style="display:inline-flex;align-items:center;gap:8px;background:linear-gradient(180deg,#ffffff,#eeeef0);border:1px solid rgba(23,23,23,0.15);color:#171717;border-radius:999px;padding:14px 24px;font-size:14px;font-weight:600;text-decoration:none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.46-1.2-1.11-1.52-1.11-1.52-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05a9.3 9.3 0 015 0c1.9-1.32 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0022 12.2C22 6.58 17.52 2 12 2z"/></svg>
        GitHub
      </a>
    </div>
  </div>

  <div data-s="card" style="border:1px solid rgba(23,23,23,0.1);border-radius:16px;overflow:hidden;box-shadow:0 20px 50px -25px rgba(0,0,0,0.25);background:#fff;">
    <div data-s="pill" style="background:linear-gradient(180deg,#f4f4f5,#e4e4e7);padding:12px 18px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(23,23,23,0.08);">
      <span data-i18n="latest" style="font-size:13px;font-weight:600;">Últimos projetos</span>
      <a href="#projetos" data-i18n="learnMore" style="font-family:JetBrains Mono,monospace;font-size:12px;color:#171717;text-decoration:none;">Saiba mais →</a>
    </div>
    <div data-m="hero-carousel" class="hero-carousel" style="position:relative;aspect-ratio:16/10;overflow:hidden;background:repeating-linear-gradient(135deg,#fafafa,#fafafa 10px,#f1f1f2 10px,#f1f1f2 20px);">
      {projects.map((p, i) => (
        <div class="hero-slide" data-title={p.title} style={`position:absolute;inset:0;opacity:${i === 0 ? 1 : 0};`}>
          <Image
            src={p.img}
            alt={p.title}
            widths={[480, 720, 960]}
            sizes="(max-width:900px) 100vw, 520px"
            loading={i === 0 ? 'eager' : 'lazy'}
            decoding="async"
            style="width:100%;height:100%;object-fit:cover;display:block;"
          />
        </div>
      ))}

      <div class="hero-slide-caption">
        <span class="hero-slide-label">{projects[0]?.title}</span>
        <div class="hero-dots">
          {projects.map((p, i) => (
            <button type="button" class="hero-dot" data-slide-to={i} aria-label={p.title} aria-current={i === 0 ? 'true' : 'false'}></button>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const carousel = document.querySelector<HTMLElement>('[data-m="hero-carousel"]');

  if (carousel) {
    const slides = Array.from(carousel.querySelectorAll<HTMLElement>('.hero-slide'));
    const dots = Array.from(carousel.querySelectorAll<HTMLButtonElement>('.hero-dot'));
    const label = carousel.querySelector<HTMLElement>('.hero-slide-label');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let current = 0;
    let timer = 0;

    function show(next: number) {
      current = (next + slides.length) % slides.length;
      slides.forEach((slide, i) => {
        slide.style.opacity = i === current ? '1' : '0';
      });
      dots.forEach((dot, i) => {
        dot.setAttribute('aria-current', i === current ? 'true' : 'false');
      });
      if (label) label.textContent = slides[current]?.dataset.title || '';
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = 0;
      }
    }

    function start() {
      if (reduceMotion || slides.length < 2) return;
      stop();
      timer = window.setInterval(() => show(current + 1), 4500);
    }

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      })
    );

    // Pausa enquanto o usuário olha/interage com o card
    carousel.addEventListener('mouseenter', stop);
    carousel.addEventListener('mouseleave', start);
    carousel.addEventListener('focusin', stop);
    carousel.addEventListener('focusout', start);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));

    show(0);
    start();
  }
</script>
