---
// Projetos — grid de cards. Nomes fixos (não traduzidos); imagens = placeholder hachurado (como no DC).
const projects = [
  { name: 'Stranger Things' },
  { name: 'Pringles' },
  { name: 'Doutor Agenda' },
  { name: 'Agência 3D' },
  { name: 'Stockly' },
  { name: 'Super Mario' },
];
---

<section data-screen-label="Projetos" id="projetos" style="max-width:1200px;margin:0 auto;padding:clamp(40px,6vw,70px) clamp(20px,4vw,40px);">
  <div data-i18n="projectsTitle" style="font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(18px,2.4vw,24px);margin-bottom:8px;">/* PROJETOS */</div>
  <div data-i18n="projectsSub" style="font-family:JetBrains Mono,monospace;font-size:13px;color:#8b8b92;margin-bottom:36px;">// aplicações full-stack, landing pages e experiências interativas</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px;">
    {projects.map((p) => (
      <div data-s="card" class="hv-card" style="border:1px solid rgba(23,23,23,0.1);border-radius:14px;overflow:hidden;background:#fff;transition:transform .2s,box-shadow .2s;">
        <div data-s="pill" style="background:linear-gradient(180deg,#f4f4f5,#e4e4e7);padding:11px 16px;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid rgba(23,23,23,0.08);">
          <span style="font-size:13px;font-weight:600;">{p.name}</span>
          <span data-i18n="learnMore" style="font-family:JetBrains Mono,monospace;font-size:12px;color:#171717;">Saiba mais →</span>
        </div>
        <div style="aspect-ratio:16/10;background:repeating-linear-gradient(135deg,#fafafa,#fafafa 10px,#f1f1f2 10px,#f1f1f2 20px);display:flex;align-items:center;justify-content:center;">
          <span data-i18n="projShot" style="font-family:JetBrains Mono,monospace;font-size:11px;color:#9a9aa0;">captura do projeto</span>
        </div>
      </div>
    ))}
  </div>
</section>
