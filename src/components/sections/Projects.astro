---
// Projetos — grid de cards + modal "Saiba mais". Dados e imagens vêm de src/data/projects.ts.
// Cada projeto tem um <dialog> renderizado no servidor; o script só abre/fecha (Esc e foco são nativos).
import { Image } from 'astro:assets';
import { projects } from '../../data/projects';
---

<section data-screen-label="Projetos" id="projetos" style="max-width:1200px;margin:0 auto;padding:clamp(72px,9vw,120px) clamp(20px,4vw,40px);">
  <div data-i18n="projectsTitle" style="font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(18px,2.4vw,24px);margin-bottom:8px;">/* PROJETOS */</div>
  <div data-i18n="projectsSub" style="font-family:JetBrains Mono,monospace;font-size:13px;color:#8b8b92;margin-bottom:36px;">// aplicações full-stack, landing pages e experiências interativas</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:22px;">
    {projects.map((p, i) => (
      <div data-s="card" class="hv-card" style="border:1px solid rgba(23,23,23,0.1);border-radius:14px;overflow:hidden;background:#fff;transition:transform .2s,box-shadow .2s;">
        <div data-s="pill" style="background:linear-gradient(180deg,#f4f4f5,#e4e4e7);padding:11px 16px;display:flex;align-items:center;justify-content:space-between;gap:10px;border-bottom:1px solid rgba(23,23,23,0.08);">
          <span style="font-size:13px;font-weight:600;">{p.title}</span>
          <button
            type="button"
            class="project-open"
            data-project-index={i}
            data-i18n="learnMore"
            style="font-family:JetBrains Mono,monospace;font-size:12px;color:#171717;background:none;border:none;padding:0;cursor:pointer;white-space:nowrap;"
          >Saiba mais →</button>
        </div>
        <div style="aspect-ratio:16/10;overflow:hidden;background:repeating-linear-gradient(135deg,#fafafa,#fafafa 10px,#f1f1f2 10px,#f1f1f2 20px);">
          <Image
            src={p.img}
            alt={p.title}
            widths={[320, 640, 960]}
            sizes="(max-width:900px) 100vw, 380px"
            loading="lazy"
            decoding="async"
            style="width:100%;height:100%;object-fit:cover;display:block;"
          />
        </div>
      </div>
    ))}
  </div>

  {projects.map((p, i) => (
    <dialog class="project-modal" data-s="card" data-project-modal={i} aria-label={p.title}>
      <div class="project-modal-inner">
        <button type="button" class="project-close" data-i18n-aria="closeModal" aria-label="Fechar" title="Fechar">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M18 6L6 18" stroke="#171717" stroke-width="2" stroke-linecap="round"/></svg>
        </button>

        <h3 style="font-family:JetBrains Mono,monospace;font-weight:700;font-size:clamp(17px,2.2vw,21px);margin:0 0 16px;padding-right:34px;">{p.title}</h3>

        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:20px;">
          {p.techs.map((t) => (
            <span data-s="pill" class="tech-chip" style="display:inline-flex;align-items:center;gap:7px;background:linear-gradient(180deg,#ffffff,#eeeef0);border:1px solid rgba(23,23,23,0.14);border-radius:999px;padding:6px 12px;font-size:12.5px;font-weight:500;">
              <img src={t.icon} alt="" width="16" height="16" loading="lazy" decoding="async" style="width:16px;height:16px;object-fit:contain;display:block;" />
              {t.name}
            </span>
          ))}
        </div>

        <div class="project-modal-rule"></div>

        <p data-s="muted" style="font-size:14.5px;line-height:1.6;color:#4b4b52;margin:0 0 26px;">{p.description}</p>

        <div style="display:flex;gap:12px;flex-wrap:wrap;">
          <a href={p.repo} target="_blank" rel="noopener" data-s="solid" class="hv-solid" style="flex:1 1 150px;display:inline-flex;align-items:center;justify-content:center;gap:8px;background:#171717;color:#fff;border-radius:999px;padding:13px 22px;font-size:14px;font-weight:600;text-decoration:none;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="#fff"><path d="M12 2C6.48 2 2 6.58 2 12.2c0 4.5 2.87 8.32 6.84 9.67.5.1.68-.22.68-.49 0-.24-.01-.87-.01-1.71-2.78.62-3.37-1.37-3.37-1.37-.46-1.2-1.11-1.52-1.11-1.52-.91-.63.07-.62.07-.62 1 .07 1.53 1.05 1.53 1.05.9 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.64-1.37-2.22-.26-4.56-1.14-4.56-5.06 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.31.1-2.73 0 0 .84-.27 2.75 1.05a9.3 9.3 0 015 0c1.9-1.32 2.74-1.05 2.74-1.05.55 1.42.2 2.47.1 2.73.64.72 1.03 1.63 1.03 2.75 0 3.93-2.35 4.79-4.58 5.05.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0022 12.2C22 6.58 17.52 2 12 2z"/></svg>
            <span data-i18n="repoBtn">Repositório</span>
          </a>
          <a href={p.url} target="_blank" rel="noopener" data-s="pill" class="hv-pill" style="flex:1 1 150px;display:inline-flex;align-items:center;justify-content:center;gap:8px;background:linear-gradient(180deg,#ffffff,#eeeef0);border:1px solid rgba(23,23,23,0.15);color:#171717;border-radius:999px;padding:13px 22px;font-size:14px;font-weight:600;text-decoration:none;">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5" stroke="#171717" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span data-i18n="deployBtn">Ver deploy</span>
          </a>
        </div>
      </div>
    </dialog>
  ))}
</section>

<script>
  const modals = Array.from(
    document.querySelectorAll<HTMLDialogElement>('[data-project-modal]')
  );

  // showModal() não trava o scroll da página: fazemos isso na mão, compensando
  // a largura da barra de rolagem para a página não "pular" ao abrir.
  const html = document.documentElement;
  function lockScroll() {
    const gap = window.innerWidth - html.clientWidth;
    html.style.overflow = 'hidden';
    if (gap > 0) html.style.paddingRight = `${gap}px`;
  }
  function unlockScroll() {
    html.style.overflow = '';
    html.style.paddingRight = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.project-open').forEach((btn) => {
    btn.addEventListener('click', () => {
      const idx = Number(btn.dataset.projectIndex);
      const dialog = modals[idx];
      if (!dialog) return;
      lockScroll();
      dialog.showModal();
    });
  });

  modals.forEach((dialog) => {
    dialog.querySelector('.project-close')?.addEventListener('click', () => dialog.close());
    // Clique fora do conteúdo (na área do próprio <dialog>) fecha
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    // Cobre todos os caminhos de fechamento, inclusive o Esc nativo
    dialog.addEventListener('close', unlockScroll);
  });
</script>
