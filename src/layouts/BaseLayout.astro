---
// Layout base. Fontes Space Grotesk + JetBrains Mono via Google Fonts (como no design DC).
// O tema (data-theme) e o idioma (lang) são resolvidos por um script inline no <head>,
// antes do paint, para evitar flash. O restante da interatividade fica em src/scripts/ui.ts.
import '../styles/global.css';
import SEO from '../components/seo/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description, path } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Fallback sem JS: o próprio SVG troca de fundo via prefers-color-scheme.
        Com JS, o script abaixo troca o href para seguir o tema escolhido no site. */}
    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon/myfavicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />

    {/* Aplica tema + idioma antes do paint (evita flash claro→escuro / PT→EN) */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('jv-portfolio-theme');
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);

          var fav = document.getElementById('favicon');
          if (fav) fav.setAttribute('href', '/favicon/myfavicon-' + t + '.svg');

          var l = localStorage.getItem('jv-portfolio-lang');
          if (l !== 'pt' && l !== 'en') {
            l = (navigator.language || 'pt').toLowerCase().indexOf('pt') === 0 ? 'pt' : 'en';
          }
          document.documentElement.setAttribute('lang', l === 'pt' ? 'pt-BR' : 'en');
        } catch (e) {}
      })();
    </script>

    <SEO title={title} description={description} path={path} />
  </head>
  <body>
    <div
      data-theme-root="true"
      style="background:#ffffff;color:#171717;font-family:Space Grotesk,Helvetica,Arial,sans-serif;overflow-x:clip;position:relative;min-height:100vh;transition:background .25s,color .25s;"
    >
      <slot />
    </div>
  </body>
</html>
