---
// Layout base. Fontes Space Grotesk + JetBrains Mono via Google Fonts (como no design DC).
// O tema (data-theme) e o idioma (lang) são resolvidos por um script inline no <head>,
// antes do paint, para evitar flash. O restante da interatividade fica em src/scripts/ui.ts.
import '../styles/global.css';
import SEO from '../components/seo/SEO.astro';

interface Props {
  title?: string;
  description?: string;
  path?: string;
}

const { title, description, path } = Astro.props;

// Uma const só porque o href aparece duas vezes abaixo (preload + fallback noscript)
// e as duas precisam bater exatamente, senão o browser baixa a folha duas vezes.
const FONTS_HREF =
  'https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap';
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    {/* Fallback sem JS: o próprio SVG troca de fundo via prefers-color-scheme.
        Com JS, o script abaixo troca o href para seguir o tema escolhido no site. */}
    <link id="favicon" rel="icon" type="image/svg+xml" href="/favicon/myfavicon.svg" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* Como <link rel="stylesheet"> a folha do Google bloqueia o primeiro paint:
        a página espera uma ida ao servidor dela antes de desenhar qualquer coisa.
        Como preload ela baixa em paralelo e só vira stylesheet quando chega. O
        display=swap na URL já cuida do texto no intervalo (desenha na fonte de
        sistema e troca depois). O <noscript> cobre quem não executa o onload. */}
    <link rel="preload" as="style" href={FONTS_HREF} onload="this.onload=null;this.rel='stylesheet'" />
    <noscript><link rel="stylesheet" href={FONTS_HREF} /></noscript>

    {/* Aplica tema + idioma antes do paint (evita flash claro→escuro / PT→EN) */}
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('jv-portfolio-theme');
          if (t !== 'dark' && t !== 'light') {
            t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          }
          document.documentElement.setAttribute('data-theme', t);

          var fav = document.getElementById('favicon');
          if (fav) fav.setAttribute('href', '/favicon/myfavicon-' + t + '.svg');

          // Marca que há JS antes do paint: só então o CSS esconde os [data-anim]
          // para a animação de entrada. Sem JS, o conteúdo nasce visível.
          document.documentElement.setAttribute('data-js', '');

          var l = localStorage.getItem('jv-portfolio-lang');
          if (l !== 'pt' && l !== 'en') {
            l = (navigator.language || 'pt').toLowerCase().indexOf('pt') === 0 ? 'pt' : 'en';
          }
          document.documentElement.setAttribute('lang', l === 'pt' ? 'pt-BR' : 'en');
        } catch (e) {}
      })();
    </script>

    <SEO title={title} description={description} path={path} />
  </head>
  <body>
    <div
      data-theme-root="true"
      style="background:#ffffff;color:#171717;font-family:Space Grotesk,Helvetica,Arial,sans-serif;overflow-x:clip;position:relative;min-height:100vh;transition:background .25s,color .25s;"
    >
      {/* Primeiro elemento focável da página: com o Tab ele desce da borda superior
          e leva direto ao <main>, pulando os 5 links do header. Fora do foco fica
          escondido acima do viewport, sem ocupar espaço. */}
      <a href="#conteudo" class="skip-link" data-i18n="skipLink">Pular para o conteúdo</a>
      <slot />
    </div>
  </body>
</html>
